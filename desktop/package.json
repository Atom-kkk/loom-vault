{
  "name": "loom-vault-desktop",
  "productName": "Loom",
  "version": "2.2.0",
  "private": true,
  "description": "Loom 织造所 · 本地 AI 出图工作台（桌面版）",
  "author": "Atom-kkk",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "node scripts/stage-web.mjs && electron-builder --mac",
    "dist:win": "node scripts/stage-web.mjs && electron-builder --win",
    "dist": "node scripts/stage-web.mjs && electron-builder --mac --win",
    "stage": "node scripts/stage-web.mjs"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.atomkkk.loom",
    "productName": "Loom",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "staging",
        "to": "web"
      },
      {
        "from": "runtime/python",
        "to": "python"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "extendInfo": {
        "LSMinimumSystemVersion": "11.0"
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Loom 织造所"
    },
    "asar": true,
    "compression": "normal"
  }
}
