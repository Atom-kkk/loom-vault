.DS_Store
__pycache__/
*.pyc
*.log

# 参考库缩略图（4345 张，约 68 MB）已入库：
# 这样克隆下来就能直接用，GitHub Pages 也不用在 CI 里现拉。
# 想换源重拉：python3 scripts/fetch_reference_gcore.py（幂等，已有文件会跳过）
reference/_failed.txt

# 本地引擎状态（含路径/pid，属本机，不入库）
.engine.json
.engine.log

# 本地引擎（setup-engine 脚本自动下载，不入库，体积几个 GB）
engine/

# 测试缓存
.pytest_cache/

# ---- 桌面版构建产物（均可由脚本再生，不入库）----
# electron 依赖：npm install 再生
desktop/node_modules/
# 安装包与解包产物：npm run dist:mac / dist:win 再生
desktop/dist/
# stage-web.mjs 的中间产物（网页文件副本，构建时从仓库根重新复制）
desktop/staging/
# 内置 standalone Python（约 67MB，二进制）：按 scripts/stage-web.mjs 的报错提示
# 下载 python-build-standalone（macOS arm64 / win64 的 install_only 版）解压到 desktop/runtime/python
desktop/runtime/

# ZCode 会话本地配置
.zcode/
